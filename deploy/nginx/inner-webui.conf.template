server {
  listen 80;
  server_name __SERVER_NAME__;
  return 308 https://__SERVER_NAME__$request_uri;
}

server {
  listen 443 ssl http2;
  server_name __SERVER_NAME__;

  ssl_certificate __TLS_CERTIFICATE__;
  ssl_certificate_key __TLS_CERTIFICATE_KEY__;
  server_tokens off;

  location = /releases {
    return 308 /releases/;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location ~ ^/releases/(?:.*/)?\. {
    return 404;
  }

  location = /releases/latest.json {
    alias __RELEASES_ROOT__/latest.json;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location /releases/ {
    alias __RELEASES_ROOT__/;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location = /webui {
    return 308 /webui/;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location ^~ /webui/assets/ {
    alias __INNER_WEBUI_ROOT__/assets/;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  location ^~ /webui/ {
    alias __INNER_WEBUI_ROOT__/current/;
    index index.html;
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'; media-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }
}
