{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "verbatimModuleSyntax": true, "skipLibCheck": true,
    "types": ["vite/client"], "paths": { "@/*": ["./src/*"], "@mugen/inner-protocol": ["../../packages/inner-protocol/src"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
