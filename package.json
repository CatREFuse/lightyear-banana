{
  "name": "mugen",
  "private": true,
  "version": "0.3.19",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.6.2 <12"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "webui",
    "plug-in",
    "homesite"
  ],
  "overrides": {
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "undici": "^7.29.0"
  },
  "scripts": {
    "dev": "npm run dev:inner-webui",
    "build": "npm run build:inner-webui",
    "dev:inner-webui": "npm --workspace @mugen/inner-webui run dev",
    "build:inner-webui": "npm --workspace @mugen/inner-webui run build",
    "preview": "npm --workspace @mugen/inner-webui run preview",
    "test:inner-webui": "npm --workspace @mugen/inner-webui run test",
    "test:e2e:inner-webui": "npm --workspace @mugen/inner-webui run e2e",
    "test:protocol": "npm --workspace @mugen/inner-protocol run test",
    "test:capabilities": "npm --workspace @mugen/core run test",
    "test:ccx-host": "npm --workspace @mugen/plug-in run test:unit",
    "test:imini-provider": "node utils/imini-provider-smoke.mjs",
    "test:mock-image-api": "node --test utils/mock-image-api-server.test.mjs utils/apimart-smoke-server.test.mjs",
    "test:release-policy:utils": "node --test utils/production-origin-policy.test.mjs utils/deploy-inner-webui-release-policy.test.mjs utils/nginx-security-policy.test.mjs utils/retired-dependency-policy.test.mjs",
    "test:release-policy": "npm run test:release-policy:utils && npm --workspace @mugen/plug-in run test:policies && npm --workspace @mugen/homesite run test:deploy",
    "test:site-optics": "npm --workspace @mugen/homesite run test:optics",
    "test:site-deploy": "npm --workspace @mugen/homesite run test:deploy",
    "verify:inner-webui": "npm run test:protocol && npm run test:inner-webui && npm run test:imini-provider && npm run build:inner-webui",
    "verify:inner-webui:release": "npm run verify:inner-webui && npm run test:e2e:inner-webui",
    "verify:inner-webui:public": "node utils/deploy-inner-webui.mjs --verify-only",
    "verify:inner-release": "npm run verify:inner-webui:release && npm run test:mock-image-api && npm run test:ccx-host && npm run test:capabilities && npm run test:release-policy && npm run verify:ccx",
    "deploy:inner-webui": "node utils/deploy-inner-webui.mjs",
    "build:ccx": "npm --workspace @mugen/plug-in run typecheck && npm --workspace @mugen/plug-in run build",
    "build:ccx:watch": "npm --workspace @mugen/plug-in run build:watch",
    "verify:ccx": "npm run build:ccx && node plug-in/scripts/verify-ccx-build.mjs",
    "package:ccx": "npm run test:mock-image-api && npm run test:ccx-host && npm run test:capabilities && npm run test:release-policy && npm run package:ccx:local",
    "package:ccx:local": "npm run verify:ccx && node plug-in/scripts/package-ccx.mjs",
    "mock:image-api": "node utils/mock-image-api-server.mjs",
    "mock:apimart": "node utils/mock-image-api-server.mjs --profile apimart --fixture cats/cat-01.jpg --delay-min-ms 20 --delay-max-ms 50",
    "smoke:apimart-server": "node utils/apimart-smoke-server.mjs",
    "build:site": "npm run test:site-optics && npm run test:site-deploy && npm --workspace @mugen/homesite run build",
    "deploy:site": "npm --workspace @mugen/homesite run deploy",
    "repair:codex:win": "powershell -NoProfile -ExecutionPolicy Bypass -File utils/rebuild-codex-windows.ps1",
    "repair:codex:win:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File utils/rebuild-codex-windows.ps1 -Apply",
    "test:regressions": "node utils/regression-smoke.mjs",
    "test:prompt-presets": "node utils/prompt-presets-smoke.mjs"
  }
}
