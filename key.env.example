# WebUI 的正式 HTTPS 地址。路径会被原样写入 CCX，必须以 / 结尾。
INNER_WEBUI_URL=https://mugen.catrefuse.com/webui/
# 发行目录基准 URL，必须以 / 结尾，并提供可公开读取的 latest.json。
INNER_RELEASE_URL=https://mugen.catrefuse.com/releases/

# SSH 部署目标。DEPLOY_WEB_ROOT 必须是服务器上的绝对路径。
DEPLOY_SSH_HOST=server.your-domain.invalid
DEPLOY_SSH_USER=mugen-deploy
DEPLOY_SSH_PORT=22
# 未设置时使用系统 SSH config 或 ssh-agent。
# DEPLOY_SSH_IDENTITY_FILE=C:\\path\\to\\deployment-key
DEPLOY_WEB_ROOT=/etc/nginx/static/mugen-inner-webui
DEPLOY_RELEASES_ROOT=/etc/nginx/static/mugen-site/releases

# 官网部署参数（详见 docs/site-deployment.md；与 DEPLOY_SSH_* 兼容）
server_ip=                    # SSH 主机；与 DEPLOY_SSH_HOST 同时出现必须一致
# password=                   # 明确拒绝：脚本仅支持 SSH 公钥或 agent，不要填写
domain=                       # 官网公网域名
secondary_domain=             # 备用域名（仅记录，不作为发布或验收入口）
