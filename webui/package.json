    "@fontsource/space-mono": "^5.3.0",
    "@mugen/core": "0.1.0",
    "@mugen/inner-protocol": "1.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.2.7"
  }
}
